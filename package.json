{
  "name": "playwright-typescript-project",
  "version": "2.0.0",
  "description": "Playwright TypeScript UI + API automation for QA Sandbox",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium --project=ui-webkit",
    "test:api": "playwright test --project=api",
    "test:chromium": "playwright test --project=ui-chromium",
    "test:webkit": "playwright test --project=ui-webkit",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ci": "playwright test --workers=50%",
    "report": "playwright show-report reports/html-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "cleanup": "tsx scripts/cleanup-test-data.ts",
    "evidence:video": "node scripts/make-evidence-video.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "dotenv": "^16.3.1",
    "eslint": "^9.17.0",
    "eslint-plugin-playwright": "^2.2.0",
    "ffmpeg-static": "^5.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.18.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
